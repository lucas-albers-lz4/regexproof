{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regexproof.dev/schemas/compiled_pattern/v2",
  "title": "CompiledPatternRecord",
  "type": "object",
  "required": [
    "schema_version",
    "regex_id",
    "pattern",
    "flags",
    "dialect",
    "call_kind",
    "declared_domain"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "enum": ["1", "2"] },
    "regex_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "pattern": { "type": "string" },
    "flags": { "type": "string" },
    "dialect": {
      "type": "string",
      "enum": ["py_re", "ecma", "re2", "pcre", "yara", "rust_regex", "perl"]
    },
    "call_kind": {
      "type": "string",
      "enum": ["fullmatch", "match", "search", "exec", "substitution"]
    },
    "declared_domain": {
      "type": "object",
      "required": ["alphabet"],
      "properties": {
        "alphabet": {
          "type": "string",
          "enum": ["ascii", "unicode", "custom", "wide"]
        },
        "description": { "type": "string" }
      }
    },
    "mirror_expr": {
      "type": "string",
      "description": "Serialization of the Z3 mirror expression when encodable"
    },
    "unencodable_reason": {
      "type": "string",
      "description": "Present when compilation rejected the pattern"
    },
    "engine_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "oneOf": [
    { "required": ["mirror_expr"] },
    { "required": ["unencodable_reason"] }
  ]
}
