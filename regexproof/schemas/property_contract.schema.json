{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regexproof.dev/schemas/property_contract/v1",
  "title": "PropertyContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site",
    "guarantee",
    "input_source",
    "trust",
    "declared_domain",
    "provenance"
  ],
  "allOf": [
    {
      "if": { "required": ["adoption"] },
      "then": { "properties": { "provenance": { "const": "agent_derived" } } }
    }
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "site": { "type": "string", "minLength": 1 },
    "guarantee": { "type": "string", "minLength": 1 },
    "input_source": { "type": "string", "minLength": 1 },
    "trust": {
      "type": "string",
      "enum": ["untrusted-input", "config", "internal"]
    },
    "declared_domain": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "string",
      "enum": ["human", "version_diff", "cross_engine", "agent_derived"]
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version", "status", "authority", "approved_on", "rationale",
        "evidence", "source_url", "source_pin", "source_file", "source_sha256",
        "contract_sha256", "review"
      ],
      "properties": {
        "policy_version": { "type": "string", "const": "autonomous-contracts-v1" },
        "status": { "type": "string", "const": "approved" },
        "authority": {
          "type": "string",
          "enum": ["direct_user_approval", "standing_user_delegation"]
        },
        "approved_on": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+$" },
        "source_pin": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_file": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "review": {
          "type": "object", "additionalProperties": false,
          "required": ["author", "reviewer", "same_model"],
          "properties": {
            "author": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "reviewer": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "same_model": { "type": "boolean" }
          }
        }
      }
    },
    "family_contract": { "type": "object", "additionalProperties": true }
  }
}
