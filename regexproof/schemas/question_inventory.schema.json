{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regexproof.dev/schemas/question_inventory/v1",
  "title": "QuestionInventory",
  "type": "object",
  "required": ["schema_version", "corpus_type", "questions"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "corpus_type": {
      "type": "string",
      "enum": ["rule_corpus", "validator"]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "shape", "threat", "encoding_hint"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "shape": { "type": "integer", "minimum": 1, "maximum": 4 },
          "threat": { "type": "string" },
          "encoding_hint": { "type": "string" },
          "applies_when": { "type": "string" }
        }
      }
    }
  }
}
