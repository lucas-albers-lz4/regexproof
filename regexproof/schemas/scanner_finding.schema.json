{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regexproof.dev/schemas/scanner_finding/v1",
  "title": "ScannerFinding",
  "type": "object",
  "required": [
    "schema_version",
    "regex_id",
    "kind",
    "corpus",
    "result",
    "site"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "regex_id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "property",
        "rule_diff",
        "redos",
        "usage_mismatch",
        "intent_mismatch",
        "triage"
      ]
    },
    "corpus": { "type": "string" },
    "result": { "type": "string" },
    "site": { "type": "string" },
    "pattern": { "type": "string" },
    "shape": { "type": ["integer", "null"] },
    "ground_truth_status": { "type": ["string", "null"] },
    "ground_truth": {
      "description": "Optional per-engine ground-truth evidence (cross-engine rule_diff).",
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "disclosure": {
      "type": ["string", "null"],
      "enum": ["private_first", "public_ok", null]
    },
    "witness": {},
    "domain": { "type": ["string", "null"] },
    "wall_ms": { "type": ["integer", "null"] },
    "engine_versions": { "type": ["object", "null"], "additionalProperties": true },
    "detail": { "type": "object", "additionalProperties": true }
  }
}
