          },
          {
            "is_target": false,
            "line": 36,
            "text": "export function secretReadBlockReason(filePath) {"
          },
          {
            "is_target": false,
            "line": 37,
            "text": "  if (!filePath || typeof filePath !== \"string\") return \"\";"
          },
          {
            "is_target": false,
            "line": 38,
            "text": "  const normalized = normalize(filePath);"
          },
          {
            "is_target": false,
            "line": 39,
            "text": "  const base = basename(normalized);"
          },
          {
            "is_target": false,
            "line": 40,
            "text": "  if (PUBLIC_KEY_RE.test(base)) return \"\";"
          },
          {
            "is_target": false,
            "line": 41,
            "text": "  if (SECRET_BASENAME_RE.test(base)) return \"secret-bearing basename\";"
          },
          {
            "is_target": false,
            "line": 42,
            "text": "  if (SECRET_EXTENSION_RE.test(base)) return \"secret-bearing file extension\";"
          },
          {
            "is_target": false,
            "line": 43,
            "text": "  if (HOST_RUNTIME_CONFIG_RE.test(normalized)) return \"host runtime config path\";"
          },
          {
            "is_target": false,
            "line": 44,
            "text": "  if (SECRET_PATH_RE.test(normalized)) return \"credential-store path\";"
          },
          {
            "is_target": false,
            "line": 45,
            "text": "  return \"\";"
